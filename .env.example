# Copy to .env and adjust. Never commit real keys.

# --- Store ---------------------------------------------------------------------------------
# asyncpg URL for the app; Alembic/DBOS derive the sync (psycopg / postgresql://) form.
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:55432/relay
# Optional: server used by the test suite (a throwaway database is created per run).
# TEST_DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:55432/relay

# --- LLM providers (local Ollama by default; frontier only when configured) ----------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model refs are "<provider>:<model>", provider in {ollama, openai, anthropic}.
# The model part may itself contain colons (e.g. ollama:gemma4:e4b).
DELEGATOR_MODEL=ollama:gemma4:e4b
DELEGATOR_FALLBACK_MODEL=ollama:gemma4:e4b
ASSENT_MODEL=ollama:gemma4:e4b
READY_MODEL=ollama:gemma4:e4b
SUMMARY_MODEL=ollama:gemma4:e4b
RESEARCH_MODEL=ollama:qwen3.8:latest
RESEARCH_FALLBACK_MODEL=ollama:gemma4:e4b
# Delegator reasoning effort for openai: models (voice: keep none)
DELEGATOR_REASONING_EFFORT=none
# Task-difficulty routing (decision-5)
ROUTER_MODEL=ollama:gemma4:e4b
ROUTER_TIMEOUT_S=5
RESEARCH_EASY_MODEL=ollama:gemma4:e4b
RESEARCH_HARD_MODEL=openai:gpt-6-luna
RESEARCH_HARD_FALLBACK_MODEL=ollama:qwen3.8:latest
# Per-turn router (TASK-36/41): shadow backends log decisions only; ROUTER_ACTIVE is not
# acted on yet (TASK-37). Backends: laya (needs the laya-mlx package), llm.
ROUTER_SHADOW=
ROUTER_ACTIVE=none
# Zero-shot LLM router: a small local or cloud model, never the frontier model.
ROUTER_LLM_MODEL=ollama:gemma4:e4b
ROUTER_LLM_TIMEOUT_MS=2000
ROUTER_LLM_CONTEXT_TURNS=6
ROUTER_LLM_CONTEXT_CHARS=4000

# --- Delegator / voice ---------------------------------------------------------------------
DELEGATOR_SHARED_SECRET=dev-secret-change-me
DELEGATOR_PUBLIC_URL=http://localhost:8000
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Demo website (TASK-42) ---------------------------------------------------------------
# Passcode for the /demo API and site. Empty disables the demo entirely. Never commit a value.
DEMO_PASSCODE=
DEMO_MAX_VOICE_SECONDS=600
DEMO_WEB_DIST=web/dist
DEMO_TASK_POLL_S=0.5

# --- Executor ------------------------------------------------------------------------------
# Comma-separated task kinds the executor accepts: research, code
ENABLED_KINDS=research,code
ARTIFACTS_DIR=./artifacts
EXECUTOR_URL=http://localhost:8001
# Root for per-idea project folders (one per idea); must be outside the relay repository
EXECUTOR_PROJECTS_ROOT=~/relay-projects
# Code tasks: token to push the task branch and open a DRAFT PR (never merged). Needs contents
# and pull-request write (and repo creation for projects without an origin). Empty keeps the
# result as a local branch in the project folder. GITHUB_OWNER: owner for new private repos.
GITHUB_TOKEN=
GITHUB_OWNER=

# --- Client --------------------------------------------------------------------------------
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
SILENCE_TIMEOUT_S=60
